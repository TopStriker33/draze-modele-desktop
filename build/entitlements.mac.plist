<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Les appels : sans ces deux-là, le hardened runtime coupe la caméra et
       le micro sans rien dire, et l'appel part avec une image noire. -->
  <key>com.apple.security.device.camera</key>
  <true/>
  <key>com.apple.security.device.audio-input</key>
  <true/>
  <!-- Electron a besoin de ces deux exceptions pour démarrer sous hardened
       runtime (JIT de V8, bibliothèques signées par nous et non par Apple). -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
</dict>
</plist>
